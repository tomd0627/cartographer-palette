{
  "name": "cartographers-palette",
  "version": "1.0.0",
  "description": "Procedural fantasy map generator — vanilla JS, Canvas API",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky"
  },
  "lint-staged": {
    "*.css": [
      "stylelint --fix",
      "prettier --write"
